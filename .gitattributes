# Line endings for development files
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Binaries should keep native line endings
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.test binary
